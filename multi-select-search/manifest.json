{
  "manifest_version": 3,
  "name": "Multi-Select Tag Search",
  "version": "1.1.0",
  "description": "Select several tags on a page at once, then open one search that combines all of them.",
  "permissions": ["activeTab", "scripting", "declarativeContent"],
  "background": {
    "service_worker": "src/background/serviceWorker.js"
  },
  "action": {
    "default_title": "Multi-select tag search",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
